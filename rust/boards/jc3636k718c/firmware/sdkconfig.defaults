# Overrides on top of ../../../../sdkconfig.jc3636k718c (the board baseline).
# esp-idf-sys needs a larger main stack than the C app for std threads.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# The board's custom partitions.csv (OTA + storage) is resolved relative to the
# generated CMake project under target/, where it does not exist. Spike uses a
# built-in table; the real layout is a follow-up decision.
# CONFIG_PARTITION_TABLE_CUSTOM is not set
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# The legacy I2C driver (components/driver/i2c) gets linked into the Rust image
# and its start-up constructor aborts when the new driver (used by the BSP) is
# present: "i2c: CONFLICT! driver_ng is not allowed to be used with this old
# driver". Nothing here calls the legacy API, so skip the check. Root cause
# (why the legacy object is pulled in) is not investigated.
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y

# UI (the Rust main task) runs on core 0; core 1 is reserved for the audio task
# (priority 20). The board baseline pins main to core 1, where an audio task
# that fills its core starves main and IDLE1.
# CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1 is not set
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y

# Run code and rodata from the flash cache, not PSRAM (XIP from PSRAM made the audio
# path slow and competes with the display's PSRAM traffic). Baseline sets both to y.
# CONFIG_SPIRAM_FETCH_INSTRUCTIONS is not set
# CONFIG_SPIRAM_RODATA is not set
