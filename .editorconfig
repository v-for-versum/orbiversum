# ---------------------------------------------------------------------------
# Editor defaults, so the code looks the same regardless of editor or OS.
# The firmware is built on Linux and Windows; line endings and indentation are
# the two things that generate noise in diffs when they drift.
# ---------------------------------------------------------------------------
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h}]
indent_size = 4

[*.{cpp,hpp}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{cmake,txt}]
indent_size = 2

[CMakeLists.txt]
indent_size = 4

[*.{md,markdown}]
# Trailing whitespace is meaningful in Markdown (hard line break).
trim_trailing_whitespace = false

[*.{ps1,psm1}]
indent_size = 4

[*.sh]
indent_size = 4

# Generated by SquareLine Studio via tools/squareline_sync.* — never edited by
# hand, so it should not be reformatted either.
[components/ui/generated/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = 4

[Makefile]
indent_style = tab
